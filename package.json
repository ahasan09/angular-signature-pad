    "@angular/compiler-cli": "~13.4.0",
    "@angular/core": "~13.4.0",
    "@angular/platform-browser": "~13.4.0",
    "@angular/platform-browser-dynamic": "~13.4.0",
    "@types/jasmine": "~3.10.18",
    "@types/node": "12.20.55",
    "jasmine-core": "~4.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~4.0.2",
    "karma-jasmine-html-reporter": "~1.7.0",
