{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-signature-pad": {
      "projectType": "library",
      "root": "projects/ngx-signature-pad",
      "sourceRoot": "projects/ngx-signature-pad/src",
      "prefix": "signature",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-signature-pad/tsconfig.lib.json",
            "project": "projects/ngx-signature-pad/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-signature-pad/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-signature-pad/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-signature-pad/tsconfig.spec.json",
            "runner": "vitest",
            "browsers": [
              "chromiumHeadless"
            ],
            "polyfills": [
              "zone.js"
            ],
            "coverageInclude": [
              "projects/ngx-signature-pad/src/lib/**/*.ts"
            ],
            "coverageReporters": [
              "text-summary",
              "html"
            ],
            "coverageThresholds": {
              "statements": 95,
              "branches": 85,
              "functions": 95,
              "lines": 95
            }
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "index": "projects/demo/src/index.html",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "styles": [
              "projects/demo/src/styles.css"
            ],
            "outputPath": "dist/demo"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kB",
                  "maximumError": "500kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
